menu "App Settings"
    config APP_ENABLE_HEAP_STATS
        bool "Enable heap stats task"
        default n
        help
          When enabled, starts the periodic heap logging task.

    config APP_ENABLE_DUAL_CORE
      bool "Enable dual core"
      default n
      help
        When enabled, it uses both cores to run tasks. Mainly used for heap stats task.          

endmenu
